# Copy this to terraform.tfvars on Server A (NOT committed to git -- see
# .gitignore) and fill in your actual account-specific values.

aws_region        = "us-east-1"
ami_id            = "ami-xxxxxxxxxxxxxxxxx"
instance_type     = "t3.micro"
server_number     = "1"
security_group_id = "sg-xxxxxxxxxxxxxxxxx"
