REGISTRY={{ registry }}
IMAGE_TAG={{ image_tag }}

# Login portal. Generated once on the control node under files/secrets/
# (gitignored) and reused for every web server, so all servers accept the
# same JWT and share one admin password. Put a value in one of those files
# before the first run to use it instead of a random one.
AUTH_DB_PASSWORD={{ lookup('password', 'files/secrets/auth_db_password chars=ascii_letters,digits length=40') }}
JWT_SECRET={{ lookup('password', 'files/secrets/jwt_secret chars=ascii_letters,digits length=64') }}
ADMIN_PASSWORD={{ lookup('password', 'files/secrets/admin_password chars=ascii_letters,digits length=20') }}
