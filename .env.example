# Copy to .env on the deployment server (used by docker-compose.prod.yml)
REGISTRY=docker.io/yourdockerhubusername
IMAGE_TAG=latest

# Login portal (auth-service + auth-db). Generate each with: openssl rand -hex 32
AUTH_DB_PASSWORD=change-me
JWT_SECRET=change-me
# Password for the main "admin" account (reset to this value on every start)
ADMIN_PASSWORD=change-me
